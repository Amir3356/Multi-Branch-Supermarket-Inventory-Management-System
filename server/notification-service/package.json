{
  "name": "notification-service",
  "private": true,
  "version": "1.0.0",
  "description": "Live updates over Socket.IO (private channels) and outgoing email",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.11.1",
    "@grpc/proto-loader": "0.7.13",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.52.1",
    "@opentelemetry/resources": "1.25.1",
    "@opentelemetry/sdk-trace-base": "1.25.1",
    "@opentelemetry/sdk-trace-node": "1.25.1",
    "@opentelemetry/semantic-conventions": "1.25.1",
    "dotenv": "16.4.5",
    "express": "5.1.0",
    "kafkajs": "2.2.4",
    "nodemailer": "10.1.7",
    "prom-client": "15.1.3",
    "socket.io": "4.8.1",
    "zod": "4.6.7"
  }
