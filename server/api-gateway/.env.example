# The API gateway: the one public entry point for the React client
# Copy to .env in this folder. Real environment variables (e.g. from docker-compose) override these.

NODE_ENV=development

# The port the browser connects to (http://localhost:8000/api, /socket.io)
GATEWAY_PORT=8000

# Shared secret on every internal call: must be the SAME value in every service's .env.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_SECRET=change-me-to-a-long-random-string

# Behind a reverse proxy or load balancer: its IPs (comma-separated) or "*", so services see real visitor IPs
TRUSTED_PROXIES=

# How long AI answers may take (seconds); the gateway waits this long plus 15s for ai-service
OPENROUTER_TIMEOUT=60
