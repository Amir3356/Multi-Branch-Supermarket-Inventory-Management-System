          "refId": "A",
          "expr": "100 * sum(rate(http_request_duration_seconds_bucket{service=~\"$service\", le=\"0.25\"}[5m])) / sum(rate(http_request_duration_seconds_count{service=~\"$service\"}[5m]))",
