        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pg_stat_database_deadlocks{datname=\"multi_branch_supermarket\"}[1h])) or vector(0)",
