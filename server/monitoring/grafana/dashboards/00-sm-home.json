    {
      "type": "stat",
      "title": "Kafka consumer lag",
      "description": "Events still waiting to be read",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(clamp_min(kafka_consumergroup_lag, 0)) or vector(0)",
