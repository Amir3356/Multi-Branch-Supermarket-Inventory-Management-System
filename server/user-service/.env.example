# user-service: staff accounts, invitations, user (access review) reports
# Copy to .env in this folder. Real environment variables (e.g. from docker-compose) override these.

NODE_ENV=development

# Shared secret on every internal call: must be the SAME value in every service's .env.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_SECRET=change-me-to-a-long-random-string

# ---- Services ----
# This service listens on the port in its own URL
USER_SERVICE_URL=http://localhost:4002
# Services this one calls
AUTH_SERVICE_URL=http://localhost:4001
REPORTING_SERVICE_URL=http://localhost:4007
NOTIFICATION_SERVICE_URL=http://localhost:4009

# ---- Database (one PostgreSQL database shared by the services; this one writes only its own tables) ----
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=multi_branch_pharmacy
DB_USERNAME=postgres
DB_PASSWORD=
# Connection pool of this service: the most connections open at once (keep the total of every service under
# PostgreSQL's max_connections, 100 by default), how long a query waits for a free connection before failing
# (milliseconds; 0 = wait forever), and how long an unused connection stays open (milliseconds; 0 = never closed)
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# The pharmacy's local time zone: "today", "this month"… follow it; the database stays in UTC
PHARMACY_TIMEZONE=Africa/Addis_Ababa

# ---- Accounts ----
# The React app: invitation links in emails point here
FRONTEND_URL=http://localhost:5173
# Invitation links stop working this many minutes after they are sent (resend from Account Provision)
INVITATION_EXPIRE_MINUTES=10
# Access reviews: days without sign-in before an account is flagged dormant
ACCESS_REVIEW_DORMANT_DAYS=90
# Empty = off. daily | weekly | monthly | quarterly | yearly = also generate a user report after each finished period
ACCESS_REVIEW_SCHEDULE=
